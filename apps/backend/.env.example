# Local development
NODE_ENV=development
APP_NAME=backend
APP_VERSION=1.0.0
SERVER_PORT=3013

FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3013
CORS_ORIGINS=http://localhost:3000

# Localhost must use a host-only cookie, so leave COOKIE_DOMAIN empty.
COOKIE_DOMAIN=
COOKIE_NAME=access_token
REFRESH_COOKIE_NAME=refresh_token
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_ACCESS_MAX_AGE_SECONDS=900
COOKIE_REFRESH_MAX_AGE_SECONDS=604800
OAUTH_STATE_COOKIE_NAME=oauth_state
OAUTH_RETURN_TO_COOKIE_NAME=oauth_return_to
OAUTH_COOKIE_MAX_AGE_SECONDS=600

JWT_ACCESS_EXPIRES=15m
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_EXPIRES=7d
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret

PUBLIC_SERVICE_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/public-service

GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3013/api/auth/google/callback
GITHUB_CLIENT_ID=replace-with-github-client-id
GITHUB_CLIENT_SECRET=replace-with-github-client-secret
GITHUB_CALLBACK_URL=http://localhost:3013/api/auth/github/callback

LOCAL_STORAGE_DIR=./storage/uploads
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_ACCOUNT_ID=replace-with-r2-account-id
R2_BUCKET=replace-with-r2-bucket-name
R2_PUBLIC_BASE_URL=https://replace-with-r2-public-host.example
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key

RESEND_API_KEY=replace-with-resend-api-key
RESEND_FROM_EMAIL=info@example.com
SIGNED_URL_EXPIRES_SECONDS=3600
SMTP_FROM=auth@example.com
SMTP_PORT=587
SUPER_ADMIN_EMAILS=admin@example.com

# Production example (set these in the deployment secret manager, not this file):
# NODE_ENV=production
# FRONTEND_URL=https://xingfan-studio.com
# BACKEND_URL=https://api.xingfan-studio.com
# CORS_ORIGINS=https://xingfan-studio.com
# COOKIE_DOMAIN=.xingfan-studio.com
# COOKIE_SECURE=true
# COOKIE_SAME_SITE=lax
# GOOGLE_CALLBACK_URL=https://api.xingfan-studio.com/api/auth/google/callback
# GITHUB_CALLBACK_URL=https://api.xingfan-studio.com/api/auth/github/callback
