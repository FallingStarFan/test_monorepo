{
  "name": "test_monorepo",
  "version": "0.0.1",
  "description": "pnpm workspace monorepo (apps/* + packages/*)",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@8.15.5",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "secrets:set:backend": "infisical secrets set --file=\"./apps/backend/.env\" --env=dev --path=/backend",
    "secrets:set:frontend": "infisical secrets set --file=\"./apps/frontend/.env\" --env=dev --path=/frontend",
    "dev:backend": "infisical run --env=dev --path=/backend -- pnpm --filter @test/backend start:dev",
    "dev:frontend": "infisical run --env=dev --path=/frontend -- pnpm --filter @test/frontend dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "format": "pnpm -r format"
  }
}
